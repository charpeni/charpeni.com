{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortImports": {
    "groups": [
      "value-builtin",
      "value-external",
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "type-import",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "dist",
    ".astro",
    ".vercel",
    "prototype",
    "pages",
    "components",
    "utils",
    "scripts",
    "styles",
    "next-env.d.ts",
    "pnpm-lock.yaml"
  ]
}
