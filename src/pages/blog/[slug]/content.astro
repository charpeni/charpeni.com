---
import { getCollection, render } from 'astro:content';

import { mdxComponents } from '@/components/mdx';
import Comments from '@/components/reader/Comments.astro';
import SeriesStack from '@/components/SeriesStack.astro';
import { shortHash } from '@/utils/graph';
import { getReadingStats, getResponsiveImage } from '@/utils/postMeta';
import { branchOf, formatLongDate, isBranch } from '@/utils/retro';

/**
 * Page partial: a post's show-window content, fetched by the window manager
 * when a post opens client-side. Prerendered by the same MDX pipeline as the
 * full page (which is what deep links and crawlers get). Excluded from
 * sitemap + robots; X-Robots-Tag noindex via vercel.json.
 */
export const partial = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const stats = getReadingStats(post.body ?? '');
const branch = branchOf({ tags: post.data.tags });
const otherTags = post.data.tags.filter((t) => !isBranch(t));

const metaBefore = `commit ${shortHash(post.id)}\nAuthor: Nicolas Charpentier <`;
const metaAfter =
  `>\nDate: ${formatLongDate(post.data.publishedAt)}\nSize: ${stats.readingTime.text}` +
  (branch ? `\nrefs:   refs/heads/${branch}` : '') +
  (otherTags.length > 0 ? `\ntopic:  ${otherTags.join(', ')}` : '');
---

<div data-window-content>
  <div class="retro-terminal-show-scroll">
    <div class="retro-terminal-show-header">
      <div class="retro-terminal-show-meta">{metaBefore}<a
          href="mailto:blog@nicolascharpentier.com"
          >blog@nicolascharpentier.com</a
        >{metaAfter}</div>
      <button
        type="button"
        class="retro-terminal-copy-mobile"
        data-copy-markdown={post.id}>Copy</button
      >
    </div>
    <div class="retro-terminal-show-title">{post.data.title}</div>
    {
      post.data.image ? (
        <div class="retro-terminal-banner" aria-hidden="true">
          <img
            class="retro-terminal-banner-img absolute inset-0 w-full h-full object-cover"
            src={post.data.image}
            srcset={getResponsiveImage(post.data.image)?.srcset}
            sizes="(max-width: 950px) 100vw, 900px"
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
          />
        </div>
      ) : null
    }
    <SeriesStack post={post} />
    <div class="prose retro-terminal-prose max-w-none w-full">
      <Content components={mdxComponents} />
    </div>
    <div class="retro-terminal-comments">
      <div class="retro-terminal-comments-title retro-only">comments</div>
      <Comments title={post.data.title} />
    </div>
  </div>
</div>
