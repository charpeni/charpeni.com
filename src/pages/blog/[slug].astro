---
import { getCollection, render } from 'astro:content';

import DesktopShell from '@/components/desktop/DesktopShell.astro';
import { mdxComponents } from '@/components/mdx';
import Comments from '@/components/reader/Comments.astro';
import CopyAsMarkdownButton from '@/components/reader/CopyAsMarkdownButton.astro';
import Footer from '@/components/reader/Footer.astro';
import Header from '@/components/reader/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getBlurDataURL,
  getOgImagePath,
  getReadingStats,
  getResponsiveImage,
  SITE_URL,
  sortByPublishedAt,
} from '@/utils/postMeta';
import { formatLongDate } from '@/utils/retro';
import { blogPostingLd, breadcrumbLd } from '@/utils/structuredData';

import type { TermPost } from '@/utils/retro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const all = sortByPublishedAt(await getCollection('posts'));
const termPosts: TermPost[] = all.map((p) => ({
  slug: p.id,
  title: p.data.title,
  publishedAt: p.data.publishedAt,
  tags: p.data.tags,
  readingTimeText: getReadingStats(p.body ?? '').readingTime.text,
  image: p.data.image,
}));
const termPost = termPosts.find((p) => p.slug === post.id)!;

const { Content } = await render(post);
const stats = getReadingStats(post.body ?? '');

const postUrl = `${SITE_URL}/blog/${post.id}`;
const markdownUrl = `${SITE_URL}/blog/${post.id}.md`;
const socialImage = getOgImagePath(post);
const imageUrl = socialImage ? `${SITE_URL}${socialImage}` : undefined;
const publishedAtIso = new Date(post.data.publishedAt).toISOString();
const updatedAtIso = post.data.updatedAt
  ? new Date(post.data.updatedAt).toISOString()
  : publishedAtIso;
const blurDataURL = getBlurDataURL(post.data.image);

const structuredData = [
  blogPostingLd({
    title: post.data.title,
    summary: post.data.summary,
    imageUrl,
    publishedAtIso,
    updatedAtIso,
    tags: post.data.tags,
    postUrl,
  }),
  breadcrumbLd({ title: post.data.title, postUrl }),
];
---

<BaseLayout
  title={`${post.data.title} | Nicolas Charpentier`}
  description={post.data.summary}
  image={imageUrl}
  type="article"
  date={publishedAtIso}
  updatedAt={post.data.updatedAt ? updatedAtIso : undefined}
  tags={post.data.tags}
  structuredData={structuredData}
  markdownUrl={markdownUrl}
>
  <Header />
  <DesktopShell posts={termPosts} focused="show" post={termPost}>
    <Fragment slot="article">
      <h1
        class="retro-terminal-show-title font-black text-3xl md:text-4xl lg:text-5xl leading-tight tracking-tight text-black dark:text-white mb-6 lg:mb-12"
      >
        {post.data.title}
      </h1>

      {
        post.data.image ? (
          <div
            class="retro-terminal-banner relative w-full aspect-[2/1] mb-6 lg:mb-8 rounded-xl overflow-hidden"
            aria-hidden="true"
            style={
              blurDataURL
                ? `background-image:url(${blurDataURL});background-size:cover`
                : undefined
            }
          >
            <img
              class="retro-terminal-banner-img absolute inset-0 w-full h-full object-cover"
              src={post.data.image}
              srcset={getResponsiveImage(post.data.image)?.srcset}
              sizes="(max-width: 950px) 100vw, 900px"
              alt=""
              aria-hidden="true"
              loading="eager"
              decoding="async"
            />
          </div>
        ) : null
      }

      <div
        class="reader-only flex flex-row items-center justify-between gap-2 md:gap-4 text-gray-700 dark:text-gray-300 mb-4"
      >
        <div class="flex items-center gap-3">
          <div
            class="flex-shrink-0 relative w-12 h-12 rounded-full overflow-hidden shadow-[0_0_20px_rgba(59,130,246,0.08),0_0_40px_rgba(147,51,234,0.05),0_0_60px_rgba(236,72,153,0.03)]"
          >
            <div class="absolute -inset-[3px] gradientRotate"></div>
            <div
              class="absolute inset-[2px] bg-gray-50 dark:bg-gray-900 rounded-full overflow-hidden"
            >
              <img
                class="object-cover rounded-full w-full h-full"
                src="/static/images/nicolas_charpentier.jpeg"
                alt="Nicolas Charpentier"
              />
            </div>
          </div>
          <div>
            <div class="font-medium">Nicolas Charpentier</div>
            <div class="text-sm text-gray-500">
              {formatLongDate(post.data.publishedAt)}
            </div>
          </div>
        </div>
        <div class="hidden md:flex items-center gap-2">
          <CopyAsMarkdownButton slug={post.id} />
          <span
            class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-sm"
            >{stats.readingTime.text}</span
          >
        </div>
        <div class="md:hidden flex flex-col items-end gap-1">
          <span
            class="px-2 sm:px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-xs sm:text-sm mt-3 sm:mt-0"
            >{stats.readingTime.text}</span
          >
          <CopyAsMarkdownButton slug={post.id} />
        </div>
      </div>

      <div class="prose dark:prose-dark retro-terminal-prose max-w-none w-full">
        <Content components={mdxComponents} />
      </div>

      <footer
        class="reader-only mt-12 pt-6 border-t border-gray-200 dark:border-gray-800"
      >
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-6"
        >
          <div class="flex items-center gap-4">
            <span class="font-medium text-gray-700 dark:text-gray-300"
              >Share this article</span
            >
            <div class="flex gap-2">
              <button
                title="Share on X"
                aria-label="Share on X"
                data-share="x"
                data-share-title={post.data.title}
                data-share-url={postUrl}
                class="cursor-pointer transition-transform hover:scale-110 w-10 h-10 rounded-full bg-black flex items-center justify-center"
              >
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="#ffffff"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
                  ></path></svg
                >
              </button>
              <button
                title="Share on LinkedIn"
                aria-label="Share on LinkedIn"
                data-share="linkedin"
                data-share-url={postUrl}
                class="cursor-pointer transition-transform hover:scale-110 w-10 h-10 rounded-full bg-[#0077b5] flex items-center justify-center"
              >
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="#ffffff"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                  ></path></svg
                >
              </button>
            </div>
          </div>
          <a
            href={`https://github.com/charpeni/charpeni.com/edit/main/posts/${post.id}.mdx`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
          >
            <svg
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
              ></path></svg
            >
            Edit on GitHub</a
          >
        </div>
      </footer>
    </Fragment>

    <Fragment slot="comments">
      <div class="retro-terminal-comments">
        <div class="retro-terminal-comments-title retro-only">comments</div>
        <Comments title={post.data.title} />
      </div>
    </Fragment>
  </DesktopShell>
  <Footer />
</BaseLayout>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>(
      '[data-share]',
    );
    if (!button) return;
    const postUrl = button.dataset.shareUrl ?? location.href;
    const url =
      button.dataset.share === 'x'
        ? `https://x.com/intent/tweet?text=${encodeURIComponent(`${button.dataset.shareTitle} by @charpeni_\n\n${postUrl}`)}`
        : `https://www.linkedin.com/sharing/share-offsite?url=${encodeURIComponent(postUrl)}`;
    // Centered share popup — port of utils/openWindow.ts.
    const [width, height] = [550, 400];
    const config: Record<string, string | number> = {
      width,
      height,
      left:
        window.outerWidth / 2 +
        (window.screenX || window.screenLeft || 0) -
        width / 2,
      top:
        window.outerHeight / 2 +
        (window.screenY || window.screenTop || 0) -
        height / 2,
      location: 'no',
      toolbar: 'no',
      status: 'no',
      directories: 'no',
      menubar: 'no',
      scrollbars: 'yes',
      resizable: 'no',
      centerscreen: 'yes',
      chrome: 'yes',
    };
    window.open(
      url,
      '',
      Object.keys(config)
        .map((key) => `${key}=${config[key]}`)
        .join(', '),
    );
  });
</script>
