---
import { getCollection } from 'astro:content';

import DesktopShell from '@/components/desktop/DesktopShell.astro';
import Footer from '@/components/reader/Footer.astro';
import Header from '@/components/reader/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getReadingStats, SITE_URL, sortByPublishedAt } from '@/utils/postMeta';

import type { TermPost } from '@/utils/retro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const all = sortByPublishedAt(await getCollection('posts'));
const termPosts: TermPost[] = all.map((p) => ({
  slug: p.id,
  title: p.data.title,
  publishedAt: p.data.publishedAt,
  tags: p.data.tags,
  readingTimeText: getReadingStats(p.body ?? '').readingTime.text,
  image: p.data.image,
}));
const tagged = all
  .filter((post) => post.data.tags.includes(tag!))
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    summary: post.data.summary,
    publishedAt: post.data.publishedAt,
    readingTimeText: getReadingStats(post.body ?? '').readingTime.text,
    tags: post.data.tags,
  }));

// Port of pages/tags/[tag].tsx: same title/description shapes, breadcrumb
// structured data, and list layout.
const title = `#${tag} · Nicolas Charpentier`;
const description = `Posts tagged ${tag} — ${tagged.length} ${
  tagged.length === 1 ? 'entry' : 'entries'
}.`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    {
      '@type': 'ListItem',
      position: 2,
      name: `#${tag}`,
      item: `${SITE_URL}/tags/${tag}`,
    },
  ],
};

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} structuredData={[breadcrumbLd]}>
  <Header />
  <DesktopShell posts={termPosts} focused="term" />

  <main
    id="skip"
    class="reader-only flex flex-col justify-center items-start max-w-4xl w-full mx-auto mb-16 px-8"
  >
    <section class="w-full">
      <nav
        aria-label="Breadcrumb"
        class="font-mono text-xs text-gray-500 dark:text-gray-500 mb-4"
      >
        <a
          href="/"
          class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >← all posts</a
        >
      </nav>

      <div class="mb-10 border-b border-gray-200 dark:border-gray-800 pb-4">
        <h1
          class="font-bold text-3xl md:text-4xl tracking-tight text-black dark:text-white"
        >
          <span class="font-mono text-gray-400 dark:text-gray-600">#</span
          >{tag}
        </h1>
      </div>

      {
        tagged.length === 0 ? (
          <p class="text-gray-600 dark:text-gray-400">
            No posts under this tag yet.
          </p>
        ) : (
          <ul class="flex flex-col divide-y divide-gray-200 dark:divide-gray-800">
            {tagged.map((post) => (
              <li class="py-5 first:pt-0">
                <a
                  href={`/blog/${post.slug}`}
                  class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  <h2 class="text-lg sm:text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {post.title}
                  </h2>
                  <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-gray-500 dark:text-gray-400">
                    <time datetime={post.publishedAt}>
                      {dateFormatter.format(new Date(post.publishedAt))}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{post.readingTimeText}</span>
                  </div>
                  <p class="mt-2 text-gray-600 dark:text-gray-400 leading-relaxed">
                    {post.summary}
                  </p>
                </a>
                {post.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
                    {post.tags.map((t) => (
                      <li>
                        <a
                          href={`/tags/${t}`}
                          class="inline-block font-mono text-xs text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-800 rounded px-2 py-0.5 hover:text-blue-600 dark:hover:text-blue-400 hover:border-gray-400 dark:hover:border-gray-600 transition-colors"
                        >
                          #{t}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
  <Footer />
</BaseLayout>
