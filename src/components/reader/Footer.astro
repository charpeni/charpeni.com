---
import Socials from '@/components/reader/Socials.astro';

/** Reader-mode footer — port of components/Footer.tsx. */
---

<footer
  class="reader-only flex flex-col justify-center items-start max-w-2xl mx-auto w-full mb-8"
>
  <hr class="w-full border-1 border-gray-200 dark:border-gray-800 mb-8" />
  <div class="flex justify-center max-w-2xl mx-auto w-full">
    <Socials />
  </div>
  <div
    class="flex flex-col justify-center items-center max-w-2xl mx-auto w-full mt-2 text-sm text-gray-400 dark:text-gray-600"
  >
    <div class="mb-2">
      <a href="/disclaimer">Disclaimer</a>
      <span class="px-1">|</span>
      <a href="/privacy-policy">Privacy Policy</a>
    </div>
    <div class="flex flex-col md:flex-row items-center">
      <span class="mr-1">© 2021-present Nicolas Charpentier.</span>
      <span>All Rights Reserved.</span>
    </div>
  </div>
</footer>
